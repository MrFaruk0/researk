{
  "name": "@researk/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Terminal client for the Researk Harness",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "researk": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "tsc -b --clean",
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@researk/contracts": "0.0.0",
    "@researk/harness": "0.0.0",
    "@researk/provider-openai-compatible": "0.0.0",
    "@researk/research": "0.0.0"
  }
}
