{
  "name": "@researk/cli",
  "version": "0.1.0-alpha.1",
  "description": "Terminal client for the Researk Harness",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrFaruk0/researk.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/MrFaruk0/researk/issues"
  },
  "homepage": "https://github.com/MrFaruk0/researk#readme",
  "type": "module",
  "bin": {
    "researk": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "tsc -b --clean",
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@researk/contracts": "0.1.0-alpha.1",
    "@researk/harness": "0.1.0-alpha.1",
    "@researk/latex-renderer": "0.1.0-alpha.1",
    "@researk/provider-openai-compatible": "0.1.0-alpha.1",
    "@researk/provider-openrouter": "0.1.0-alpha.1",
    "@researk/research": "0.1.0-alpha.1"
  }
}
